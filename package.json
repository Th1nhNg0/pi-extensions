{
  "name": "pi-extensions",
  "version": "1.0.0",
  "description": "Personal collection of custom extensions for Pi Coding Agent by Th1nhNg0",
  "type": "module",
  "author": "Thinh Ngo",
  "repository": {
    "type": "git",
    "url": "https://github.com/Th1nhNg0/pi-extensions.git"
  },
  "homepage": "https://github.com/Th1nhNg0/pi-extensions#readme",
  "bugs": {
    "url": "https://github.com/Th1nhNg0/pi-extensions/issues"
  },
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "pi-extension"
  ],
  "main": "extensions/startup-entry.ts",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "test": "bash scripts/test.sh",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "npm run format:check && npm run typecheck && npm test"
  },
  "pi": {
    "extensions": [
      "extensions/startup-entry.ts"
    ]
  },
  "license": "MIT",
  "dependencies": {
    "@xhayper/discord-rpc": "1.3.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@earendil-works/pi-coding-agent": "*",
    "typescript": "^7.0.2"
  }
}
